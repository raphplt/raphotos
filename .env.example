# Copier en .env et compléter. Ne jamais committer le .env (il est ignoré).

# ---------------------------------------------------------------- Supabase
# Tableau de bord → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : contourne RLS. Strictement serveur, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------- Cloudflare
# Tableau de bord Cloudflare → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raphotos

# URL publique du bucket : domaine personnalisé, ou URL r2.dev pour démarrer
NEXT_PUBLIC_CDN_URL=https://cdn.raphotos.fr

# ------------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=https://raphotos.fr

# Seule adresse autorisée à accéder à /admin
ADMIN_EMAIL=raphael.plassart@gmail.com

# Sel du hachage des adresses IP (rate limiting). Générer une valeur aléatoire :
#   openssl rand -hex 32
IP_HASH_SALT=
